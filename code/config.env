# Testbed layout: the single source of truth.
# Read by scripts/*.sh (sourced) and by bench/testbed.py (parsed as KEY=VALUE).
# CPU numbers are for the i7-14650HX: P-core threads 0-15 in sibling pairs
# (0,1) (2,3) ..., E-cores 16-23 in two clusters (16-19, 20-23) that share L2.
# Rule: never put two different roles on the two threads of one P-core.

HOUSEKEEPING_CPUS=0,1     # OS, desktop, monitoring, orchestration (everything else is confined here during runs)
LOADGEN_CPUS=2,3,4,5      # load generator + client-side receive processing (RPS); both threads of its two cores:
                          # with only 2,4 it saturated above ~4500 req/s (campaign S2, journal)
LB_CPUS=6                 # router forwarding + the LB (RPS on the router's client-facing veth)

CLIENT_IP=10.0.0.2
ROUTER_CLIENT_IP=10.0.0.1
ROUTER_FABRIC_IP=10.1.0.1
LB_IP=10.1.0.10
VIP=10.2.0.1

CLIENT_MTU=1500           # client side: normal Internet MTU
FABRIC_MTU=1600           # LB <-> backends: room for our 40-byte encapsulation

BACKEND_PORT=8080
METRICS_PORT=9100
