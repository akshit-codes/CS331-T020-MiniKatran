# cluster.conf: the four-laptop setup (docs/cluster-runbook.md).
# Copy to cluster/cluster.conf, fill in, and keep it identical on all machines.

TRANSPORT=ssh                 # ssh: real machines (netns: emulation, see emulated.conf)
REPO=/home/student/cs331-lb   # where the repo is checked out, the same path on every machine
SSH_USER=student              # optional; key-based login, passwordless sudo on every machine

CLIENT=client                 # the machine running the load generator
LB=lb                         # the machine running the director and the controller
VIP=10.2.0.1
BACKEND_PORT=8080
METRICS_PORT=9100
ENCAP_PORT=7700
LOADGEN_CPUS=2-5              # on the client
VIP_ROUTE_MTU=1460            # the client's route to the VIP: 1500 - our 40-byte encapsulation

# Workload (D39): a request costs 40 ms of CPU instead of 1 ms (backends then manage
# ~30-50 req/s each), the SLO scales with it, and there are fewer connections, so each
# still lives a few seconds (well under the 20 s dwell). These worked on a phone hotspot;
# 20 ms / 400 ms / 64 didn't (runbook). With 32 connections the generator's pool fills
# about when the backends do, so try more if send delays show up below capacity.
COST_MS=40
SLO_P99_MS=800
CONNS=32
LONG_LIVED_CONNS=20
LONG_LIVED_RATE=10

# host  name    address        interface   housekeeping CPUs (all else is confined here during runs)
host    client  192.168.43.10  wlp2s0      0,1
host    lb      192.168.43.11  wlp3s0      0,1
host    h1      192.168.43.12  wlp2s0      0,1
host    h2      192.168.43.13  wlp0s20f3   0,1

# backend name  machine  address      CPUs  kind  [slowness]
# Keep these four names (the scenarios use them). The backends of one machine
# share a /24 whose .1 is that machine; different machines, different /24s.
# kind: P or E (which core type of that laptop; used for calibration).
backend beP1    h1       10.11.1.11   2,4   P     1.6
backend beP2    h1       10.11.1.12   6,8   P
backend beE1    h2       10.11.2.13   2,4   P
backend beE2    h2       10.11.2.14   6,8   P
